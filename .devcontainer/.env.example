# Variables of the development container: copy this file as .env (in this same folder) and fill it in
# The .env file is not uploaded to Git, so it has to be created on each computer

# Token of the Discord bot used for development (use a test bot, not the production one, or both will respond at the same time)
DISCORD_TOKEN=

# Bot language (optional): leave empty to choose it from the bot menu (en-US by default), or set it to fix it (for example: en-US, es-ES), which locks it in the menu
LOCALE=

# Name of the development database, and credentials of its administrator user (created on the first start of the container)
DB_NAME=helpbot
DB_USERNAME=
DB_PASSWORD=

# Remote error tracking with Sentry (optional): the DSN of your Sentry project, and the share of performance traces to send, from 0 to 1 (1 by default)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
