// Development container for Visual Studio Code: runs the bot inside Docker, with its own MongoDB database, on any computer that opens the repository
// Before opening it for the first time on a computer, copy .env.example as .env (in this folder) and fill it in
{
    "name": "HelpBot",

    // Uses the services of docker-compose.yml, and opens the bot service
    "dockerComposeFile": "docker-compose.yml",
    "service": "helpbot",
    "workspaceFolder": "/workspaces/HelpBot",

    // Stops the database when the window is closed
    "shutdownAction": "stopCompose",

    // When the container is created, fills the empty database settings of the development configuration file (so the database can be created meanwhile), and installs the dependencies (their folder is a Docker volume, owned by the container user)
    "postCreateCommand": "node docker/generate-database-config.js && sudo chown node node_modules && npm ci",

    // On every start, fills the empty database settings again, in case the development configuration file was removed
    "postStartCommand": "node docker/generate-database-config.js",

    // Uses the user of the image instead of root
    "remoteUser": "node"
}
