# Copy this file as .env (in the same folder as docker-compose.yml) and fill it in

# Discord bot token
DISCORD_TOKEN=

# Bot language (for example: en-US, es-ES)
LOCALE=en-US

# Database name, and credentials of the MongoDB administrator user (created on the first start)
DB_NAME=helpbot
DB_USERNAME=
DB_PASSWORD=

# Remote error tracking with Sentry (optional, also requires errorTracking.enabled in data/config.json)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=

# MongoDB image (optional): leave empty to use mongo:7, or use mongo:4.4 on CPUs without AVX support
MONGO_IMAGE=

# HelpBot image tag (optional): leave empty for the stable version ("latest"), or use "beta"
HELPBOT_TAG=