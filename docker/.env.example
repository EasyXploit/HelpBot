# Copy this file as .env (in the same folder as docker-compose.yml) and fill it in

# Discord bot token (optional): leave it empty to enter it in the bot console on the first start, which stores it in the database. If it is set here, it takes precedence, and it can not be changed from the bot
DISCORD_TOKEN=

# Bot language (optional): leave empty to choose it from the bot menu (en-US by default), or set it to fix it (for example: en-US, es-ES), which locks it in the menu
LOCALE=

# Database (optional): leave them empty to use the MongoDB of this project, with the name and user "helpbot" and a random password, which are stored in data/config.json on the first start
# Fill them in (here, or in data/config.json) before the first start to choose them yourself, or to connect to a MongoDB of your own (along with the settings below). The ones set here take precedence over data/config.json
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Another MongoDB (optional): its address, port and the database where its user is defined (usually "admin")
DB_TARGET=
DB_PORT=
DB_AUTH_SOURCE=

# Remote error tracking with Sentry (optional): the DSN of your Sentry project, and the share of performance traces to send, from 0 to 1 (1 by default)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=

# MongoDB image (optional): leave empty to use mongo:7, or use mongo:4.4 on CPUs without AVX support
MONGO_IMAGE=

# HelpBot image tag (optional): leave empty for the stable version ("latest"), or use "beta"
HELPBOT_TAG=

# Automatic updates (optional): leave empty or use "true" to update the bot whenever a new image is published, or "false" to disable them
AUTO_UPDATE=